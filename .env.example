# Public Frontend Configuration (Safe to expose to browser with VITE_ prefix)
# API Backend Base URL
VITE_BACKEND_URL=https://oneday-backend-xocv.onrender.com

# Support Contact
VITE_SUPPORT_EMAIL=onedayappco@gmail.com

# Optional Firebase Web App Config overrides (public Firebase client config only)
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=

# NOTE: Never place private keys or server secrets (GEMINI_API_KEY, SUPABASE_SERVICE_ROLE_KEY,
# FIREBASE_PRIVATE_KEY) in frontend environment variables. Those belong strictly on the backend.
